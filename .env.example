# Copia este fichero a `.env` y ajusta los valores. `.env` está en .gitignore.

# Adaptador activo. Valores soportados: local_docker
# Próximamente: aws_rds, gcp_cloudsql, azure_db
PROVIDER=local_docker

# Socket del daemon de Docker. Solo necesario si el socket NO está en
# /var/run/docker.sock (caso típico: Docker Desktop en Linux, que lo coloca
# en $HOME/.docker/desktop/docker.sock). Si usas Docker Engine clásico,
# deja esta variable comentada o vacía.
# DOCKER_HOST=unix:///home/<tu_usuario>/.docker/desktop/docker.sock

# --- AWS (solo si PROVIDER=aws_rds) ---
#
# IMPORTANTE: las credenciales (Access Key ID + Secret Access Key) NO van
# en este fichero. Configúralas en `~/.aws/credentials` con el comando
# `aws configure` o crea el fichero a mano. boto3 las lee automáticamente.
#
# Aquí solo van variables no secretas.

# AWS_REGION=eu-west-1

# Overrides opcionales de red. Déjalos sin definir para que el adaptador
# descubra la Default VPC y su Security Group automáticamente.
# AWS_DB_SUBNET_GROUP=
# AWS_SECURITY_GROUP_ID=
