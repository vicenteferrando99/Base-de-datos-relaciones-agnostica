# Copia este fichero a `.env` y ajusta los valores. `.env` está en .gitignore.
#
# Nota: `uv sync` NO crea este fichero — solo instala dependencias. La copia
# es un paso manual deliberado, porque `.env` contiene configuración propia
# de cada máquina.
#
# Todos los valores tienen un default razonable en `app/config.py`, salvo
# GCP_PROJECT (obligatorio si PROVIDER=gcp_cloudsql).

# Adaptador activo. Valores soportados: local_docker, aws_rds, gcp_cloudsql
PROVIDER=local_docker

# --- Docker (solo si PROVIDER=local_docker) ---
#
# Socket del daemon. Normalmente NO hace falta definirlo: el SDK detecta
# solo la ruta correcta en cada sistema.
#
#   Linux (Docker Engine)   -> /var/run/docker.sock          (automático)
#   Linux (Docker Desktop)  -> $HOME/.docker/desktop/docker.sock  (hay que
#                              fijarlo a mano, ver ejemplo abajo)
#   Windows (Docker Desktop)-> npipe:////./pipe/docker_engine (automático)
#   macOS  (Docker Desktop) -> $HOME/.docker/run/docker.sock  (automático)
#
# IMPORTANTE en Windows: deja esta variable COMENTADA. Un valor `unix://...`
# heredado de una configuración de Linux rompe el adaptador local_docker.
#
# DOCKER_HOST=unix:///home/<tu_usuario>/.docker/desktop/docker.sock

# --- AWS (solo si PROVIDER=aws_rds) ---
#
# IMPORTANTE: las credenciales (Access Key ID + Secret Access Key) NO van
# en este fichero. Configúralas con `aws configure`, que las escribe en:
#   Linux/macOS -> ~/.aws/credentials
#   Windows     -> %USERPROFILE%\.aws\credentials
# boto3 las lee automáticamente de ahí.
#
# Aquí solo van variables no secretas.

# AWS_REGION=eu-west-1

# Overrides opcionales de red. Déjalos sin definir para que el adaptador
# descubra la Default VPC y cree/reutilice su Security Group automáticamente.
# AWS_DB_SUBNET_GROUP=
# AWS_SECURITY_GROUP_ID=

# --- GCP (solo si PROVIDER=gcp_cloudsql) ---
#
# IMPORTANTE: las credenciales tampoco van aquí. Se generan con
# `gcloud auth application-default login`, que las escribe en:
#   Linux/macOS -> ~/.config/gcloud/application_default_credentials.json
#   Windows     -> %APPDATA%\gcloud\application_default_credentials.json
# La librería de Google las lee automáticamente (Application Default
# Credentials). Marca TODOS los permisos en la pantalla de consentimiento.
#
# GCP_PROJECT es OBLIGATORIO si PROVIDER=gcp_cloudsql (no tiene default).

# GCP_PROJECT=<tu-project-id>
# GCP_REGION=europe-west1
